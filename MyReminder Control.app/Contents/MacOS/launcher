#!/bin/bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

PROJECT_DIR="/Users/Hasan/Desktop/Hasan/MyReminder"
PORT="5252"
DASHBOARD_URL="http://127.0.0.1:${PORT}"
LOG_DIR="${HOME}/Library/Logs/MyReminder"
mkdir -p "${LOG_DIR}"

if ! curl -fsS "${DASHBOARD_URL}/api/status" >/dev/null 2>&1; then
  cd "${PROJECT_DIR}"
  nohup node "${PROJECT_DIR}/src/cli-start-server.js" >>"${LOG_DIR}/server.log" 2>&1 < /dev/null &
  for _ in {1..20}; do
    if curl -fsS "${DASHBOARD_URL}/api/status" >/dev/null 2>&1; then
      break
    fi
    sleep 0.25
  done
fi

if [[ "${MYREMINDER_HEADLESS_TEST:-0}" != "1" ]]; then
  open "${DASHBOARD_URL}"
fi
